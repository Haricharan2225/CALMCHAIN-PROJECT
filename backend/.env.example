# CalmChain Backend Configuration
PORT=5000

# AI Provider Selection: 'gemini', 'groq', 'openai', 'huggingface', or 'offline'
AI_PROVIDER=offline

# Google Gemini API Key (if using gemini provider)
GEMINI_API_KEY=

# Groq API Key (if using groq provider)
GROQ_API_KEY=

# OpenAI API Key (if using openai provider)
OPENAI_API_KEY=

# Hugging Face Inference API Token (if using huggingface provider)
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
